# P0 默认全部留空即可运行（scripted 模型 + SQLite）。
# 复制为 .env 后按需填写，CLI 只读环境变量，不会自动加载本文件。

# --- 存储：P0 用 SQLite / P1 用 Postgres ---
MW_STORE=sqlite
MW_DB=./data/workbench.db
MW_DATABASE_URL=postgresql://michelin:michelin@127.0.0.1:55432/michelin

# --- P1 webhook 与 durable workflow ---
MW_WEBHOOK_SECRET=change-me
MW_APP_VERSION=michelin-p1-0.1.0
MW_APPROVAL_TIMEOUT=30

# --- 模型后端：scripted | openai_compat ---
MW_MODEL_BACKEND=scripted

# 真实模型（backend=openai_compat 时生效）。两个模型必须分属不同家族，
# 否则 build_models() 会直接拒绝启动。
MW_API_BASE=https://api.openai.com/v1
MW_API_KEY=
MW_WORKER_MODEL=claude-sonnet-4-5
MW_VERIFIER_MODEL=gpt-5-mini

# --- P2 行为验证（零 pip 依赖，需要本机 git）---
# 生成的 SKILL.md / helper / feature map / 临时 git worktree 的落盘目录，默认 data/p2-runs
MW_P2_WORKDIR=./data/p2-runs
# 设为 1 才跑 P2 的重型端到端测试（几十个子进程，约 3-4 分钟）；默认回归会 skip
# MW_P2_FULL=1

# --- P3 可配置仓库访谈器 / 结构化规则门禁 ---
# 默认零 pip 依赖：后端 python-ast（纯标准库）。装了 ast-grep 会自动做双后端对拍。
#   .venv/bin/pip install ast-grep-cli     # 0.51.1，提供 ast-grep 命令（sg 是 deprecated 别名）
# MW_P3_WORKDIR=./data/p3-runs
# MW_AST_GREP=./.venv/bin/ast-grep         # 可选，默认自动探测 PATH 与项目 .venv
# 设为 1 才跑 P3 的重型端到端测试（约 3 分钟）；默认回归会 skip
# MW_P3_FULL=1
#
# 用法：
#   python3 run.py p3-interview --repo <任意仓库> --plan plans/michelin-self.json
#   python3 run.py p3-verify --repo <任意仓库> --plan <plan.json> --scenario ok
#   python3 run.py p3-verify --rules-backend ast-grep     # 主后端换成真 ast-grep

# --- P5 PR 增量门禁 / 运行时护栏 ---
# CI 的 pull_request 事件自动带 GITHUB_BASE_REF；本地手动复现真实 diff 时可指定：
# MW_PR_BASE=main
# MW_PR_HEAD=pr-violation
# 隔离 / span / 预算账本都落在 run 目录里，不依赖外部服务：
#   python3 run.py p5-runtime --trip          # 演示黏性 kill switch
#   python3 ci/gate.py --report data/ci/gate-report.json
# 注意：本机是进程级隔离，文件越界与网络边界只是 declared-only 声明；
# 生产必须换 gVisor/Kata 容器后端（runtime/sandbox.py 的 container_command()）。

# --- 尚未接入的外部服务（当前不读取） ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# LANGFUSE_HOST=http://127.0.0.1:3000
